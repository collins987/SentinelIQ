    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "📋 Log Volume & Overview",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" } },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 1 },
      "id": 1,
      "title": "Log Volume by Service",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(count_over_time({compose_service=~\".+\"}[1m])) by (compose_service)", "legendFormat": "{{compose_service}}", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" } },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 7 },
      "id": 2,
      "title": "Error Log Volume",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(count_over_time({compose_service=~\".+\"} |~ \"(?i)(error|exception|critical|fatal)\"[1m])) by (compose_service)", "legendFormat": "{{compose_service}}", "refId": "A" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 101,
      "title": "🔑 API Logs",
