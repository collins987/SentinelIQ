      "options": { "showTime": true, "showLabels": false, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending" },
      "targets": [
        { "expr": "{compose_service=\"api\"} |~ \"(?i)(error|exception|traceback|critical)\"", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "id": 12,
      "title": "API Requests by Path (Top 10)",
      "type": "barchart",
      "targets": [
        { "expr": "topk(10, sum by (path) (count_over_time({compose_service=\"api\"} | json | path != \"\" [$__range])))", "legendFormat": "{{path}}", "refId": "A" }
