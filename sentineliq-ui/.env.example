# API Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_API_TIMEOUT=30000

# WebSocket Configuration
VITE_WS_URL=ws://localhost:8000/ws

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DEBUG_MODE=false

# Data Source Configuration
# Set to 'false' to disable mock data and use real backend API calls
VITE_ENABLE_MOCK_DATA=true

# Enable real-time updates
VITE_ENABLE_REAL_TIME=true

# Mock Data Settings (only used when VITE_ENABLE_MOCK_DATA=true)
VITE_MOCK_API_DELAY=800
VITE_POLLING_INTERVAL=5000

# Logging
VITE_LOG_LEVEL=info
VITE_DEBUG_LOGGING=true

# Stripe Keys (PUBLIC keys only - never commit secret keys)
# Get these from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLIC_KEY=pk_test_replace_with_your_key

# Sentry DSN (error tracking - optional)
VITE_SENTRY_DSN=
